# 复制为 .env.prod / .env.test（已 gitignore，勿提交真实值）
# 部署脚本 moma_deploy.js 会按 --deploy-env 复制为运行时 .env
# scf_bootstrap source .env；app.js / juzhu/server.py 禁止通过 HTTP 提供本文件

PORT=9000

# MySQL（生产必须显式配置，app.js 不再内置默认账号）
# Node 读 MYSQL_*；也兼容 Python 侧 JUZHU_DB_* 别名
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DB=
MYSQL_USER=
MYSQL_PASSWORD=

# 可选别名（与 juzhu/.env.example 的 JUZHU_DB_* 对齐）
# JUZHU_DB_HOST=
# JUZHU_DB_PORT=3306
# JUZHU_DB_NAME=
# JUZHU_DB_USER=
# JUZHU_DB_PASSWORD=

# 生产务必：
# JUZHU_ENV=production
# JUZHU_API_KEY=<强随机，禁止用 dev-juzhu-key>
# JUZHU_ADMIN_PASSWORD=<强随机，禁止用开发默认口令>

JUZHU_ENV=
JUZHU_API_KEY=local-only-change-me
JUZHU_ADMIN_PASSWORD=

# 支付中台（按部署环境填写；商家收款商户号另维护到 jz_vendors.pay_merchant_no）
PAY_APP_CODE=
PAY_PROJECT_CODE=
PAY_SHARE_BIZ_CODE=
# 平台商户号：用于接收分账
PAY_PLATFORM_MERCHANT_NO=
PAY_NOTIFY_URL=https://<public-host>/api/juzhu/payment/notify/<random-token>
PAY_NOTIFY_TOKEN=
PAY_HTTP_TIMEOUT_MS=8000
OAUTH_GATEWAY_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_CLIENT_TYPE=

# 统一收银台：关闭新支付入口时保留查单、关单、退款及履约补偿
PAY_NEW_INTENTS_ENABLED=1
PAY_POLL_SECONDS=10
PAY_JOB_LEASE_SECONDS=60
# 旧住宿客户端等待其他执行器完成当前任务的上限（毫秒，最高 10000）
PAY_COMPAT_WAIT_MS=3000
# 须与中台不可再付款的关闭终态契约一致；查无订单不视为关闭
PAY_CLOSED_STATUSES=40

# 新居住权益真实收款默认关闭，独立 commerce 进程也需注入以下配置。
# 主站与 commerce 必须连接同一 MySQL 库；COMMERCE_DB_NAME 留空继承 MYSQL_DB。
COMMERCE_PAY_ENABLED=0
COMMERCE_COLLECTION_MODE=platform
COMMERCE_PAY_MERCHANT_NO=
COMMERCE_PAY_APP_CODE=
COMMERCE_PAY_PROJECT_CODE=
COMMERCE_PAY_SHARE_BIZ_CODE=
COMMERCE_PAY_NOTIFY_URL=
COMMERCE_PAY_CONFIG_VERSION=1

# 统一结算：报表与资金执行独立；实际付款须另行准入机构契约与账户。
SETTLEMENT_REPORTS_ENABLED=1
SETTLEMENT_ENABLED=0
SETTLEMENT_WORKER_ENABLED=0
# JSON 配置存放在宿主环境，不在数据库或前端维护机构字段映射。
# 格式与核验要求见 docs/verification/unified-settlement/provider-contract.md
SETTLEMENT_PROVIDER_CONTRACTS={}
SETTLEMENT_PAYMENT_CONTRACTS={}
# PDF 中文字体须为部署机器已有且有授权的 CJK 字体。
SETTLEMENT_PDF_FONT=/usr/share/fonts/google-noto-cjk/NotoSansCJK-Regular.ttc

# 话务虚拟号（可选）
TP_BASE=http://tp-test.lianjia.com
TP_APP_ID=
TP_APP_KEY=

# 贝壳 session 验票（C 端 App H5 用 lianjia_token 换 BJZ_TOKEN）
# 测试 tta/ttb/ttc 不填则用登录 FAQ 默认 source；生产必须自申请后填写
# SESSION_SOURCE=
# SESSION_SIGNATURE=
# SESSION_VERIFY_URL=http://test3-i.token.lianjia.com
# SESSION_REFERER=http://xjzgy.ttc.test.ke.com/
# 浏览器 H5 登录（对齐 Morph mLogin；不填则按 host 选 [test-]clogin.ke.com + [test-]m.ke.com/my/checklogin）
# BEIKE_H5_LOGIN_URL=https://test-clogin.ke.com
# BEIKE_H5_SERVICE_URL=https://test-m.ke.com/my/checklogin
