# 复制为 .env.prod / .env.test（已 gitignore，勿提交真实值）
# 部署脚本 moma_deploy.js 会按 --deploy-env 复制为运行时 .env
# scf_bootstrap source .env；app.js / juzhu/server.py 禁止通过 HTTP 提供本文件

PORT=9000

# MySQL（生产必须显式配置，app.js 不再内置默认账号）
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DB=
MYSQL_USER=
MYSQL_PASSWORD=

# 生产务必：
# JUZHU_ENV=production
# JUZHU_API_KEY=<强随机，禁止用 dev-juzhu-key>
# JUZHU_ADMIN_PASSWORD=<强随机，禁止用开发默认口令>

JUZHU_ENV=
JUZHU_API_KEY=local-only-change-me
JUZHU_ADMIN_PASSWORD=

# 话务虚拟号（可选）
TP_BASE=http://tp-test.lianjia.com
TP_APP_ID=
TP_APP_KEY=
