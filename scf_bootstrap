#!/bin/bash
# SCF 启动入口：注入环境变量后启动 Node.js 服务（纯 Node 模式，无 Python 依赖）
# 运行时 .env 仅供本脚本 source，禁止通过 HTTP 访问（见 app.js isPublicStatic）

_EXTERNAL_PORT=${PORT}
DIR="$(cd "$(dirname "$0")" && pwd)"
ENV_FILE="$DIR/.env"

if [ -f "$ENV_FILE" ]; then
  # 清除平台可能预设的 MySQL 变量，确保 .env 的值生效
  unset MYSQL_HOST MYSQL_PORT MYSQL_DB MYSQL_USER MYSQL_PASSWORD
  unset JUZHU_API_KEY JUZHU_ADMIN_PASSWORD JUZHU_ENV
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
else
  echo "WARNING: $ENV_FILE not found; relying on platform-injected env vars"
fi

# 平台注入的 PORT 优先于 .env
if [ -n "$_EXTERNAL_PORT" ]; then
  export PORT=$_EXTERNAL_PORT
fi
export PORT=${PORT:-9000}

# 生产硬门禁：缺密钥或仍用历史默认值则拒绝启动
ENV_NAME="$(echo "${JUZHU_ENV:-}" | tr '[:upper:]' '[:lower:]')"
if [ "$ENV_NAME" = "prod" ] || [ "$ENV_NAME" = "production" ]; then
  if [ -z "${JUZHU_API_KEY:-}" ] || [ "${JUZHU_API_KEY}" = "dev-juzhu-key" ]; then
    echo "FATAL: production requires JUZHU_API_KEY (must not be empty or dev-juzhu-key)" >&2
    exit 1
  fi
  if [ -z "${JUZHU_ADMIN_PASSWORD:-}" ]; then
    echo "FATAL: production requires JUZHU_ADMIN_PASSWORD" >&2
    exit 1
  fi
  if [ -z "${MYSQL_HOST:-}" ] || [ -z "${MYSQL_USER:-}" ] || [ -z "${MYSQL_PASSWORD:-}" ] || [ -z "${MYSQL_DB:-}" ]; then
    echo "FATAL: production requires MYSQL_HOST/MYSQL_DB/MYSQL_USER/MYSQL_PASSWORD" >&2
    exit 1
  fi
fi

exec node "$DIR/app.js"
