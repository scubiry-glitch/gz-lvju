 // ===== 房源图片：上传载荷解析 + 落库（对象存储/本地统一，见 img_storage.cjs）=====
+/**
+ * 读取**原始 Buffer** 请求体（二进制安全；readBody 按 utf8 拼字符串，会破坏图片字节，故图片上传专用）
+ * 结果缓存在 req._rawBodyBuffer，重复调用不重复消费流。
+ */
+function readRawBody(req, maxBytes) {
+  if (req._rawBodyBuffer) return Promise.resolve(req._rawBodyBuffer);
+  return new Promise((resolve, reject) => {
+    const limit = maxBytes || (imgStorage ? imgStorage.maxBytes() + 1024 * 1024 : 16 * 1024 * 1024);
+    const chunks = [];
+    let total = 0;
+    let done = false;
+    req.on('data', (c) => {
+      if (done) return;
+      total += c.length;
+      if (total > limit) {
+        done = true;
+        reject(new Error(`请求体过大（>${(limit / 1048576).toFixed(0)}MB）`));
+        try { req.destroy(); } catch (_) { /* ignore */ }
+        return;
+      }
+      chunks.push(c);
+    });
+    req.on('end', () => {
+      if (done) return;
+      done = true;
+      req._rawBodyBuffer = Buffer.concat(chunks);
+      resolve(req._rawBodyBuffer);
+    });
+    req.on('error', (e) => { if (!done) { done = true; reject(e); } });
+  });
+}
