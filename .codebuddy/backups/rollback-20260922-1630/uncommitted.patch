+/**
+ * 极简 multipart/form-data 解析（无依赖、二进制安全）
+ * @returns {{fields:Object<string,string>, files:Object<string,{filename:string,contentType:string,data:Buffer}>}|{error:string}}
+ */
+function parseMultipart(buf, contentType) {
+  const m = /boundary=(?:"([^"]+)"|([^;]+))/i.exec(String(contentType || ''));
+  const boundary = m ? String(m[1] || m[2] || '').trim() : '';
+  if (!boundary) return { error: '缺少 multipart boundary' };
+  // 首分隔符无前导 CRLF；后续分隔符必须带 "\r\n" 前缀，
+  // 否则图片字节里偶然出现 "--boundary" 会被误判为分隔符（RFC 2046 只保证 "\r\n--boundary" 不出现）
+  const firstDelim = Buffer.from('--' + boundary);
+  const nextDelim = Buffer.from('\r\n--' + boundary);
+  const fields = {};
+  const files = {};
+  let pos = buf.indexOf(firstDelim);
+  if (pos < 0) return { error: 'multipart 边界未匹配（body 与 Content-Type 不一致？）' };
+  pos += firstDelim.length;
+  while (pos < buf.length) {
+    if (buf[pos] === 0x2d && buf[pos + 1] === 0x2d) break;          // 结束标记 "--"
+    while (pos < buf.length && (buf[pos] === 0x0d || buf[pos] === 0x0a)) pos += 1;
+    const headEnd = buf.indexOf('\r\n\r\n', pos);
+    if (headEnd < 0) break;
+    const headerText = buf.slice(pos, headEnd).toString('utf8');
+    const bodyStart = headEnd + 4;
+    let next = buf.indexOf(nextDelim, bodyStart);
+    if (next < 0) next = buf.length;                                 // 容错：末尾无完整分隔符
+    const data = buf.slice(bodyStart, next);                         // 已天然排除尾随 CRLF
+    const nameM = /name="([^"]*)"/i.exec(headerText);
+    const fileM = /filename="([^"]*)"/i.exec(headerText);
+    const ctM = /content-type:\s*([^\r\n]+)/i.exec(headerText);
+    if (nameM) {
+      const name = nameM[1];
+      if (fileM) {
+        files[name] = { filename: fileM[1], contentType: ctM ? ctM[1].trim() : '', data };
+      } else {
+        fields[name] = data.toString('utf8').trim();
+      }
+    }
+    pos = next + nextDelim.length;
+  }
+  return { fields, files };
+}
