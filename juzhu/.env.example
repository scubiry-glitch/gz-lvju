# 复制为 .env.local 后填写（.env.local 已 gitignore，勿提交真实密钥）
#   cp juzhu/.env.example juzhu/.env.local
#
# 启动：python3 juzhu/server.py  （会自动加载本目录 .env.local / .env）
# 生产务必：JUZHU_ENV=production，并显式配置下方密钥
# 禁止使用历史默认值 dev-juzhu-key（任何环境均拒绝）

JUZHU_ENV=dev
JUZHU_API_KEY=local-only-change-me
JUZHU_ADMIN_PASSWORD=

# 详细日志开关：true=分段详细日志（区分调用类别 + 请求参数 + 返回内容）；
# false=只打印请求接口 URI（一行/请求）
JUZHU_LOG_DETAIL=true

# 测试（外网可访问）
TP_BASE=http://tp-test.lianjia.com
# 线上（内网）
# TP_BASE=http://i.tp.lianjia.com

TP_APP_ID=
TP_APP_KEY=

# ── MySQL 数据库（本地与测试环境共用同一个库） ──
# dbconn（pymysql）连接参数；DB 名称由运维预建，账户需具备建表/迁移权限
JUZHU_DB_HOST=127.0.0.1
JUZHU_DB_PORT=3306
JUZHU_DB_USER=
JUZHU_DB_PASSWORD=
JUZHU_DB_NAME=juzhu

# ── 房源图片对象存储（贝壳 ODS / S3 兼容；见 docs/s3-image-storage.md） ──
# 未配置时图片自动回落本地 assets/uploads，业务不中断；配齐下面 5 项即切换对象存储。
# 注意：secret 等同密码，只放服务端 env，禁止写进前端/仓库。
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=https://ods.lianjia.com
S3_FILE_ENDPOINT=https://file.ljcdn.com
S3_BUCKET=test
# 签名版本：v4（AWS4-HMAC-SHA256，接入规范要求，缺省）| v2（AWS Signature V2，不需要 region）
S3_SIGN_VERSION=v4
# V4 必填；本环境实测 region 不参与校验（任意值均可通过），取标准默认
S3_REGION=us-east-1
# 寻址风格：path（https://endpoint/<bucket>/<key>，缺省且实测可用）
#           virtual（https://<bucket>.endpoint/<key>）：<bucket>.ods.lianjia.com 域名可解析，
#           但当前网络 80 空响应 / 443 握手重置，网关放开后改此行即可（无需改码）
S3_ADDRESSING=path
# 访问域名是否带 bucket：bucket（https://file-endpoint/<bucket>/<key>，实测有效，缺省）
#                       path  （https://file-endpoint/<key>，或 file-endpoint 本身已含 bucket）
S3_FILE_STYLE=bucket
# 对象 key 前缀（接入规范使用 lvju/）
S3_KEY_PREFIX=lvju
# 接入规范要求的额外请求头（JSON，参与签名；缺省 public-read 以便公网读图）
S3_EXTRA_HEADERS={"x-amz-acl":"public-read"}
# 单图上限（字节，缺省 12MB）
S3_MAX_BYTES=12582912
# C 端是否把对象存储图片改写为 .t240/.t640.webp 缩略图（0=关闭）
S3_THUMB_REWRITE=1
# 单次请求超时（毫秒）
S3_TIMEOUT_MS=20000

# ── 图片引用灰度/回滚开关（口径见 docs/s3-intake-api-plan.md §5） ──
# 写侧 + 读侧主开关；改环境变量即回滚，不需要发版
#   local = 最强回滚：即使 S3 配齐也不写 S3，读侧不改写（等价改造前）
#   dual  = 缺省：新上传走 S3；读侧不改写存量本地路径
#   s3    = 新上传走 S3 + 读侧把 assets/... 改写为迁移前缀下的公网 URL（不改库即可灰度切读）
IMG_URL_MODE=dual
# 外部（第三方）图片 URL 处置：keep = 原样保留（缺省，零行为变化）| mirror = 镜像进对象存储
IMG_INGEST=keep
# 是否允许 sharp 重编码（0 = 保原格式，PNG 透明不丢）
IMG_NORMALIZE=1
# S3 未配置时是否 fail-closed（生产建议 1：后端发行包不含 assets/，回落本地 = 静默丢图）
S3_FAIL_ON_UNCONFIGURED=0
# 存量迁移 key 前缀（缺省 <S3_KEY_PREFIX>/legacy）
S3_MIGRATE_PREFIX=
# IMG_INGEST=mirror 时的来源域名白名单（逗号分隔，含子域；留空 = 不限制）
S3_SOURCE_URL_ALLOWLIST=
# 删除 photos 行时是否同步删除对象（缺省 0，防误删不可恢复）
S3_DELETE_ON_PHOTO_DELETE=0
