# 复制为 .env.local 后填写（.env.local 已 gitignore，勿提交真实密钥）
#   cp juzhu/.env.example juzhu/.env.local
#
# 启动：python3 juzhu/server.py  （会自动加载本目录 .env.local / .env）
# 生产务必：JUZHU_ENV=production，并显式配置下方密钥
# 禁止使用历史默认值 dev-juzhu-key（任何环境均拒绝）

JUZHU_ENV=dev
JUZHU_API_KEY=local-only-change-me
JUZHU_ADMIN_PASSWORD=

# 详细日志开关：true=分段详细日志（区分调用类别 + 请求参数 + 返回内容）；
# false=只打印请求接口 URI（一行/请求）
JUZHU_LOG_DETAIL=true

# 测试（外网可访问）
TP_BASE=http://tp-test.lianjia.com
# 线上（内网）
# TP_BASE=http://i.tp.lianjia.com

TP_APP_ID=
TP_APP_KEY=

# ── MySQL 数据库（本地与测试环境共用同一个库） ──
# dbconn（pymysql）连接参数；DB 名称由运维预建，账户需具备建表/迁移权限
JUZHU_DB_HOST=127.0.0.1
JUZHU_DB_PORT=3306
JUZHU_DB_USER=
JUZHU_DB_PASSWORD=
JUZHU_DB_NAME=juzhu
